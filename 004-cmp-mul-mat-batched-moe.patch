     mul_mat_cmp_hfma2<<<grid, CMP_NT, 0, stream>>>(
-        x_alloc.get(), K, w_ptr, (float *) dst->data, ne0, N, M, K);
+        x_alloc.get(), K, w_ptr, ldw, sw2, sw3, (float *) dst->data, ne0, N, M, K,
+        (int) ne12, (int) (ne12/ne02), (int) (ne13/ne03));
     CUDA_CHECK(cudaGetLastError());
 }
+
+bool ggml_cuda_mul_mat_id_cmp_wanted(int device, const ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    if (!ggml_cuda_mul_mat_cmp_enabled(device)) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 || !ggml_is_quantized(src0->type)) {
+        return false;
+    }
+    if (ggml_get_to_fp16_cuda(src0->type) == nullptr || !ggml_is_contiguous(src0)) {
+        return false;
+    }
+    if (src0->ne[0] % 8 != 0 || src0->ne[1] % 8 != 0) {
+        return false;
+    }
+    return src1->ne[2] >= 32;
+}
diff --git a/ggml/src/ggml-cuda/mmcmp.cuh b/ggml/src/ggml-cuda/mmcmp.cuh
index 509094db9..b61900a97 100644
--- a/ggml/src/ggml-cuda/mmcmp.cuh
