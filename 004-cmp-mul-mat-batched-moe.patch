 void ggml_cuda_mul_mat_cmp(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
+
+// Whether a mul_mat_id (MoE) should leave MMQ/MMF and use the per-expert fallback, whose slices
+// then reach ggml_cuda_mul_mat_cmp. Needs enough tokens that experts see 8+ rows each; quantized
+// experts only (F16 experts are fed to the slices as F16 activations, which the CMP path does not take).
+bool ggml_cuda_mul_mat_id_cmp_wanted(int device, const ggml_tensor * dst);
