+    if (ggml_is_contiguous(src1)) {
+        const to_fp16_cuda_t to_fp16 = ggml_get_to_fp16_cuda(GGML_TYPE_F32);
+        to_fp16(src1->data, x_alloc.get(), ggml_nelements(src1), stream);
+    } else {
+        const to_fp16_nc_cuda_t to_fp16_nc = ggml_get_to_fp16_nc_cuda(GGML_TYPE_F32);
