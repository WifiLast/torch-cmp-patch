@@ -233,24 +253,57 @@ void ggml_cuda_mul_mat_cmp(ggml_backend_cuda_context & ctx, const ggml_tensor *
     cudaStream_t stream = ctx.stream();
 
     const half * w_ptr = (const half *) src0->data;
+    int64_t ldw = nb01/sizeof(half);
+    int64_t sw2 = nb02/sizeof(half);
+    int64_t sw3 = nb03/sizeof(half);
     ggml_cuda_pool_alloc<half> w_alloc(ctx.pool());
