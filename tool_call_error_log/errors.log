{"timestamp":"2026-10-09 12:55:52","tool":"Bash","input":{"command":"cd \"/c/Users/MARTIN~1/AppData/Local/Temp/claude/c--Users-MartinStark-Documents-GitHub-PLS-torch-cmp-patch/ad07232f-81df-45b8-bfab-0df580796a42/scratchpad/llama.cpp/ggml/src/ggml-cuda\"\ncat \u003e mmcmp.cuh \u003c\u003c\u0027EOF\u0027\n#pragma once\n\n#include \"common.cuh\"\n\n// ============================================================================\n// Dense matmul for throttled NVIDIA CMP mining cards (Turing, TU10x).\n//\n// CMP 50HX/90HX firmware throttles tensor-core HMMA and FP32 FFMA but leaves\n// packed FP16 (HFMA2) at full rate. Every dense matmul path in ggml-cuda is\n// built on one of the two throttled units: cublasGemmEx (HMMA), MMQ (int8\n// mma), MMF (mma) and the F32 fallbacks (FFMA). This kernel runs the GEMM as\n// \"dot-pair\" HFMA2 instead: a half2 accumulator holds two partial sums along\n// K, operands are read along K with 128-bit loads, and the half2 partials are\n// flushed into FP32 every CK elements, so FP16 only ever sums 32 products.\n//\n// Quantized weights take the same route as the stock cuBLAS path: dequantize\n// to F16 into a pool buffer, then GEMM. MMQ is bypassed for them.\n//\n// Derived from src/cuda/fp16_linear_hfma2.cu in torch-cmp-patch (cmpext3).\n// ============================================================================\n\n// Whether the CMP matmul is enabled for this device. Tri-state:\n//   GGML_CUDA_MMCMP = 1/on/true/yes  -\u003e force on (NVIDIA Turing+ only)\n//   GGML_CUDA_MMCMP = 0/off/false/no -\u003e force off\n//   unset                            -\u003e auto-detect an NVIDIA \"CMP \" card\nbool ggml_cuda_mul_mat_cmp_enabled(int device);\n\n// Whether this particular op is one the CMP kernel can handle.\nbool ggml_cuda_mul_mat_cmp_supported(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst);\n\nvoid ggml_cuda_mul_mat_cmp(ggml_backend_cuda_context \u0026 ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);\nEOF\ncat \u003e mmcmp.cu \u003c\u003c\u0027EOF\u0027\n#include \"mmcmp.cuh\"\n#include \"convert.cuh\"\n\n#include \u003ccstdlib\u003e\n#include \u003ccstring\u003e\n\nnamespace {\n\nconstexpr int CMP_BM = 64;    // output features per block\nconstexpr int CMP_BN = 128;   // activation rows per block\nconstexpr int CMP_CK = 64;    // K elements per shared-memory stage\nconstexpr int CMP_NT = 256;\nconstexpr int CMP_TM = 8;     // features per thread\nconstexpr int CMP_TN = 4;     // rows per thread\nconstexpr int CMP_LDS = CMP_CK + 8; // 144 B rows: odd number of 16 B chunks, conflict free\n\n__device__ __forceinline__ void cmp_hfma2_dot8(half2 \u0026 acc, const int4 \u0026 a, const int4 \u0026 b) {\n    const half2 * ha = reinterpret_cast\u003cconst half2 *\u003e(\u0026a);\n    const half2 * hb = reinterpret_cast\u003cconst half2 *\u003e(\u0026b);\n    acc = __hfma2(ha[0], hb[0], acc);\n    acc = __hfma2(ha[1], hb[1], acc);\n    acc = __hfma2(ha[2], hb[2], acc);\n    acc = __hfma2(ha[3], hb[3], acc);\n}\n\n// Y[n][m] = sum_k X[n][k] * W[m][k]     (ggml: dst = src0^T . src1)\n// X: [N][K] F16, row stride ldx. W: [M][K] F16 contiguous. Y: [N][M] F32, row stride ldy.\nstatic __global__ void __launch_bounds__(CMP_NT, 2) mul_mat_cmp_hfma2(\n        const half * __restrict__ X, const int64_t ldx,\n        const half * __restrict__ W,\n        float      * __restrict__ Y, const int64_t ldy,\n        const int N, const int M, const int K) {\n#if __CUDA_ARCH__ \u003e= GGML_CUDA_CC_TURING\n    __shared__ __align__(16) half As[CMP_BM*CMP_LDS];\n    __shared__ __align__(16) half Bs[CMP_BN*CMP_LDS];\n\n    const int     tid = threadIdx.x;\n    const int     m0  = blockIdx.y*CMP_BM;\n    const int64_t n0  = (int64_t) blockIdx.x*CMP_BN;\n    const int     tm  = tid / 32;\n    const int     tn  = tid % 32;\n\n    float acc[CMP_TM][CMP_TN];\n#pragma unroll\n    for (int i = 0; i \u003c CMP_TM; ++i) {\n#pragma unroll\n        for (int j = 0; j \u003c CMP_TN; ++j) {\n            acc[i][j] = 0.0f;\n        }\n    }\n\n    for (int k0 = 0; k0 \u003c K; k0 += CMP_CK) {\n        for (int i = tid; i \u003c CMP_BM*(CMP_CK/8); i += CMP_NT) {\n            const int r = i / (CMP_CK/8);\n            const int c = (i % (CMP_CK/8))*8;\n            int4 v = make_int4(0, 0, 0, 0);\n            if (m0 + r \u003c M \u0026\u0026 k0 + c \u003c K) {\n                v = *reinterpret_cast\u003cconst int4 *\u003e(W + (int64_t)(m0 + r)*K + k0 + c);\n            }\n            *reinterpret_cast\u003cint4 *\u003e(As + r*CMP_LDS + c) = v;\n        }\n        for (int i = tid; i \u003c CMP_BN*(CMP_CK/8); i += CMP_NT) {\n            const int r = i / (CMP_CK/8);\n            const int c = (i % (CMP_CK/8))*8;\n            int4 v = make_int4(0, 0, 0, 0);\n            if (n0 + r \u003c N \u0026\u0026 k0 + c \u003c K) {\n                v = *reinterpret_cast\u003cconst int4 *\u003e(X + (n0 + r)*ldx + k0 + c);\n            }\n            *reinterpret_cast\u003cint4 *\u003e(Bs + r*CMP_LDS + c) = v;\n        }\n        __syncthreads();\n\n        half2 hacc[CMP_TM][CMP_TN];\n#pragma unroll\n        for (int i = 0; i \u003c CMP_TM; ++i) {\n#pragma unroll\n            for (int j = 0; j \u003c CMP_TN; ++j) {\n                hacc[i][j] = __float2half2_rn(0.0f);\n            }\n        }\n#pragma unroll 2\n        for (int c = 0; c \u003c CMP_CK; c += 8) {\n            int4 af[CMP_TM];\n            int4 bf[CMP_TN];\n#pragma unroll\n            for (int i = 0; i \u003c CMP_TM; ++i) {\n                af[i] = *reinterpret_cast\u003cconst int4 *\u003e(As + (tm*CMP_TM + i)*CMP_LDS + c);\n            }\n#pragma unroll\n            for (int j = 0; j \u003c CMP_TN; ++j) {\n                bf[j] = *reinterpret_cast\u003cconst int4 *\u003e(Bs + (tn + 32*j)*CMP_LDS + c);\n            }\n#pragma unroll\n            for (int i = 0; i \u003c CMP_TM; ++i) {\n#pragma unroll\n                for (int j = 0; j \u003c CMP_TN; ++j) {\n                    cmp_hfma2_dot8(hacc[i][j], af[i], bf[j]);\n                }\n            }\n        }\n        // Leave FP16 every CMP_CK: each half lane has summed only CMP_CK/2 products.\n#pragma unroll\n        for (int i = 0; i \u003c CMP_TM; ++i) {\n#pragma unroll\n            for (int j = 0; j \u003c CMP_TN; ++j) {\n                const float2 f = __half22float2(hacc[i][j]);\n                acc[i][j] += f.x + f.y;\n            }\n        }\n        __syncthreads();\n    }\n\n    // Epilogue: 8 consecutive features per row, two 16 B stores when aligned.\n    const int mb = m0 + tm*CMP_TM;\n#pragma unroll\n    for (int j = 0; j \u003c CMP_TN; ++j) {\n        const int64_t n = n0 + tn + 32*j;\n        if (n \u003e= N) {\n            continue;\n        }\n        float * yrow = Y + n*ldy;\n        if (mb + CMP_TM \u003c= M) {\n            *reinterpret_cast\u003cfloat4 *\u003e(yrow + mb)     = make_float4(acc[0][j], acc[1][j], acc[2][j], acc[3][j]);\n            *reinterpret_cast\u003cfloat4 *\u003e(yrow + mb + 4) = make_float4(acc[4][j], acc[5][j], acc[6][j], acc[7][j]);\n        } else {\n            for (int i = 0; i \u003c CMP_TM \u0026\u0026 mb + i \u003c M; ++i) {\n                yrow[mb + i] = acc[i][j];\n            }\n        }\n    }\n#else\n    GGML_UNUSED_VARS(X, ldx, W, Y, ldy, N, M, K);\n    NO_DEVICE_CODE;\n#endif // __CUDA_ARCH__ \u003e= GGML_CUDA_CC_TURING\n}\n\nint ggml_cuda_mul_mat_cmp_env() {\n    const char * s = getenv(\"GGML_CUDA_MMCMP\");\n    if (s == nullptr || s[0] == \u0027\\0\u0027) {\n        return -1; // auto\n    }\n    if (!strcmp(s, \"0\") || !strcmp(s, \"off\") || !strcmp(s, \"false\") || !strcmp(s, \"no\")) {\n        return 0;\n    }\n    return 1;\n}\n\n} // namespace\n\nbool ggml_cuda_mul_mat_cmp_enabled(int device) {\n    static int  cached[GGML_CUDA_MAX_DEVICES];\n    static bool cached_valid[GGML_CUDA_MAX_DEVICES] = {};\n\n    if (device \u003c 0 || device \u003e= GGML_CUDA_MAX_DEVICES) {\n        return false;\n    }\n    if (cached_valid[device]) {\n        return cached[device] != 0;\n    }\n\n    const int env = ggml_cuda_mul_mat_cmp_env();\n\n    bool enabled = false;\n    if (env != 0) {\n        const int  cc      = ggml_cuda_info().devices[device].cc;\n        const bool arch_ok = GGML_CUDA_CC_IS_NVIDIA(cc) \u0026\u0026 cc \u003e= GGML_CUDA_CC_TURING;\n\n        if (env == 1) {\n            enabled = arch_ok;\n            if (!arch_ok) {\n                GGML_LOG_WARN(\"%s: GGML_CUDA_MMCMP is set but device %d is not an NVIDIA Turing+ device, ignoring\\n\",\n                    __func__, device);\n            }\n        } else {\n            // Nothing in the device properties distinguishes a throttled mining card from the\n            // GeForce part it is cut from (a CMP 50HX reports compute capability 7.5 like any\n            // TU10x), so detect by name.\n            cudaDeviceProp prop;\n            const int physical_device = ggml_cuda_info().devices[device].physical_device;\n            if (arch_ok \u0026\u0026 cudaGetDeviceProperties(\u0026prop, physical_device) == cudaSuccess) {\n                enabled = strstr(prop.name, \"CMP \") != nullptr;\n                if (enabled) {\n                    GGML_LOG_INFO(\"%s: detected %s, using the FMA-free HFMA2 matmul \"\n                        \"(set GGML_CUDA_MMCMP=0 to disable)\\n\", __func__, prop.name);\n                }\n            }\n        }\n    }\n\n    cached[device]       = enabled ? 1 : 0;\n    cached_valid[device] = true;\n    return enabled;\n}\n\nbool ggml_cuda_mul_mat_cmp_supported(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {\n    GGML_TENSOR_BINARY_OP_LOCALS\n\n    if (src1-\u003etype != GGML_TYPE_F32 || dst-\u003etype != GGML_TYPE_F32) {\n        return false;\n    }\n    // The caller asked for FP32 accumulation (models whose activations overflow FP16).\n    if (dst-\u003eop_params[0] == GGML_PREC_F32) {\n        return false;\n    }\n    if (src0-\u003etype != GGML_TYPE_F16 \u0026\u0026 ggml_get_to_fp16_cuda(src0-\u003etype) == nullptr) {\n        return false;\n    }\n    // Plain 2D weights; batched/broadcast matmuls (attention without FA, MoE slices) are left alone.\n    if (ne02 != 1 || ne03 != 1 || ne12 != 1 || ne13 != 1) {\n        return false;\n    }\n    if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(src1) || !ggml_is_contiguous(dst)) {\n        return false;\n    }\n    // Single-token decode is memory bound, not FMA bound; MMVQ/MMVF already serve it.\n    if (ne11 \u003c 8) {\n        return false;\n    }\n    // 128-bit loads along K, 128-bit stores along M.\n    if (ne00 % 8 != 0 || ne01 % 8 != 0) {\n        return false;\n    }\n    return true;\n}\n\nvoid ggml_cuda_mul_mat_cmp(ggml_backend_cuda_context \u0026 ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {\n    GGML_TENSOR_BINARY_OP_LOCALS\n\n    cudaStream_t stream = ctx.stream();\n\n    const half * w_ptr = (const half *) src0-\u003edata;\n    ggml_cuda_pool_alloc\u003chalf\u003e w_alloc(ctx.pool());\n    if (src0-\u003etype != GGML_TYPE_F16) {\n        w_alloc.alloc(ggml_nelements(src0));\n        const to_fp16_cuda_t to_fp16 = ggml_get_to_fp16_cuda(src0-\u003etype);\n        to_fp16(src0-\u003edata, w_alloc.get(), ggml_nelements(src0), stream);\n        w_ptr = w_alloc.get();\n    }\n\n    ggml_cuda_pool_alloc\u003chalf\u003e x_alloc(ctx.pool(), ggml_nelements(src1));\n    const to_fp16_cuda_t to_fp16_f32 = ggml_get_to_fp16_cuda(GGML_TYPE_F32);\n    to_fp16_f32(src1-\u003edata, x_alloc.get(), ggml_nelements(src1), stream);\n\n    const int N = (int) ne11;\n    const int M = (int) ne01;\n    const int K = (int) ne00;\n\n    const dim3 grid((N + CMP_BN - 1)/CMP_BN, (M + CMP_BM - 1)/CMP_BM);\n    mul_mat_cmp_hfma2\u003c\u003c\u003cgrid, CMP_NT, 0, stream\u003e\u003e\u003e(\n        x_alloc.get(), K, w_ptr, (float *) dst-\u003edata, ne0, N, M, K);\n    CUDA_CHECK(cudaGetLastError());\n}\nEOF\ncd ..; python - \u003c\u003c\u0027EOF\u0027\nimport re\np=\u0027ggml-cuda/ggml-cuda.cu\u0027\ns=open(p,encoding=\u0027utf-8\u0027,newline=\u0027\u0027).read()\nnl=\u0027\\r\\n\u0027 if \u0027\\r\\n\u0027 in s else \u0027\\n\u0027\ns=s.replace(\u0027#include \"ggml-cuda/mmq.cuh\"\u0027+nl,\u0027#include \"ggml-cuda/mmcmp.cuh\"\u0027+nl+\u0027#include \"ggml-cuda/mmq.cuh\"\u0027+nl,1)\nold=\u0027\u0027\u0027    const int cc        = ggml_cuda_info().devices[ctx.device].cc;\n    const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;\n\n    if (ggml_cuda_should_use_mmvf(src0-\u003etype, cc, src0-\u003ene, src0-\u003enb, ne11)) {\n        // The custom F16 vector kernel\u0027\u0027\u0027.replace(\u0027\\n\u0027,nl)\nnew=\u0027\u0027\u0027    // Throttled CMP mining cards: tensor cores and FP32 FFMA are firmware-limited, so every\n    // stock dense path below (MMQ, MMF, cuBLAS) is slow. Use the HFMA2 GEMM, see mmcmp.cuh.\n    if (ggml_cuda_mul_mat_cmp_enabled(ctx.device) \u0026\u0026 ggml_cuda_mul_mat_cmp_supported(src0, src1, dst)) {\n        ggml_cuda_mul_mat_cmp(ctx, src0, src1, dst);\n        return;\n    }\n\n\u0027\u0027\u0027.replace(\u0027\\n\u0027,nl)+old\nassert old in s\ns=s.replace(old,new,1)\nopen(p,\u0027w\u0027,encoding=\u0027utf-8\u0027,newline=\u0027\u0027).write(s)\nEOF\ngit diff --stat; git status --short"},"response":null}
